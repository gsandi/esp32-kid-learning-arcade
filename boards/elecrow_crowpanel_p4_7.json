    "espidf"
  ],
  "name": "Elecrow CrowPanel Advanced 7\" ESP32-P4 HMI",
  "upload": {
    "flash_size": "16MB",
    "maximum_ram_size": 786432,
    "maximum_size": 16777216,
    "protocol": "esp-builtin",
    "protocols": [
      "esp-builtin",
      "esptool"
    ],
    "require_upload_port": true,
    "speed": 460800
