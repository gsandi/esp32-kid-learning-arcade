{
  "build": {
    "core": "esp32",
    "extra_flags": [
      "-DARDUINO_ESP32P4_DEV",
      "-DBOARD_HAS_PSRAM"
    ],
    "f_cpu": "360000000L",
    "f_flash": "80000000L",
    "flash_mode": "dio",
    "mcu": "esp32p4",
    "variant": "esp32p4"
  },
  "connectivity": [
    "wifi",
    "bluetooth",
    "ethernet"
  ],
